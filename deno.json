{
  "name": "rho-code",
  "version": "0.8.0",
  "description": "Interactive REPL frontend for the rho coding agent",
  "license": "MIT",
  "author": "Jeff Mitchell",
  "exports": "./main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-run --allow-read --allow-env main.ts",
    "watch": "deno run --watch --allow-net --allow-run --allow-read --allow-env main.ts",
    "build": "deno compile --allow-run --allow-read --allow-env main.ts -o rho-code",
    "test": "deno test"
  }
}
